<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 标题区：固定高度，不参与挤压 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="28dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_title"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/discovering"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
      内容区：整块用 ScrollView 兜底。
      电视/投影仪的可用高度差异很大，加上系统缩放后 720p 上经常只剩 ~600dp；
      原来右卡是固定内容高度，一旦超出就整块被裁掉，连接按钮直接看不见。
      现在纵向可滚动，任何分辨率都能滚到按钮。
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="28dp"
            android:baselineAligned="false">
            <!-- 左：发现的服务器 + 最近连接 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:orientation="vertical"
                android:layout_marginEnd="24dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="可用服务端" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/server_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="120dp"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:nextFocusDown="@id/input_address"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/server_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未发现服务端，请在右侧手动输入地址"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 右：手动连接 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manual_connect"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.lanplay.client.ui.TvEditText
                    android:id="@+id/input_address"
                    style="@style/TvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/server_address"
                    android:inputType="textUri"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/input_pin"
                    android:nextFocusUp="@id/server_list" />

                <com.lanplay.client.ui.TvEditText
                    android:id="@+id/input_pin"
                    style="@style/TvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/pair_code"
                    android:inputType="number"
                    android:maxLength="6"
                    android:imeOptions="actionNext"
                    android:nextFocusDown="@id/input_name"
                    android:nextFocusUp="@id/input_address" />

                <com.lanplay.client.ui.TvEditText
                    android:id="@+id/input_name"
                    style="@style/TvInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="@string/device_name"
                    android:imeOptions="actionDone"
                    android:nextFocusDown="@id/btn_connect"
                    android:nextFocusUp="@id/input_pin" />

                <Button
                    android:id="@+id/btn_connect"
                    style="@style/TvButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:nextFocusUp="@id/input_name"
                    android:text="@string/connect" />

                <TextView
                    android:id="@+id/pair_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="提示：配对码显示在服务端窗口右上角；如服务端已关闭配对校验，可留空。"
                    android:textColor="@color/text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
